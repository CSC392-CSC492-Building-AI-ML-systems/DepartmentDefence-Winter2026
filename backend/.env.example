# Required
COHERE_API_KEY=your_cohere_api_key_here

# Optional model overrides
COHERE_CHAT_MODEL=command-r-plus-08-2024
COHERE_EMBED_MODEL=embed-english-v3.0
COHERE_RERANK_MODEL=rerank-english-v3.0

# Optional runtime toggles
ENABLE_SELF_RAG_CRITIQUE_LOOP=true
ENABLE_CONTRADICTION_ANALYSIS=true
ENABLE_CONTRADICTION_LLM_CLASSIFIER=false
ENABLE_EMBEDDING_CACHE=true

# Optional dashboard access key (set to enable /api/eval/* routes)
# DASHBOARD_ACCESS_KEY=local-dev-key
