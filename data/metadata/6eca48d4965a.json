      "markdown": "## Fixed time rate contracts",
      "plain_text": "Fixed time rate contracts"
    },
    {
      "block_id": "6eca48d4965a::b0005",
      "section_id": "6eca48d4965a::s003",
      "type": "paragraph",
      "heading_path": [
        "Buyer's Guide Manage payments - Fixed time rate contracts",
        "Buyer's Guide",
        "Fixed time rate contracts"
      ],
      "markdown": "Time charged and the accuracy of the contractor\u2019s time recording are subject to verification by Canada. This can occur before or after payment is made to the contractor under the terms of the contract.",
      "plain_text": "Time charged and the accuracy of the contractor\u2019s time recording are subject to verification by Canada. This can occur before or after payment is made to the contractor under the terms of the contract."
    },
    {
      "block_id": "6eca48d4965a::b0006",
      "section_id": "6eca48d4965a::s003",
      "type": "paragraph",
      "heading_path": [
        "Buyer's Guide Manage payments - Fixed time rate contracts",
        "Buyer's Guide",
        "Fixed time rate contracts"
