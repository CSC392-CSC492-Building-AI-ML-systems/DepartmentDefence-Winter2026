      "section_id": "4a1ee8936091::s004",
      "type": "paragraph",
      "heading_path": [
        "Buyer's Guide Manage a contract - Contract dispute resolution",
        "Buyer's Guide",
        "Contract dispute resolution",
        "Handling conflicts with contractors"
