      "markdown": "## Administrative guidance for implementing contract amendments",
      "plain_text": "Administrative guidance for implementing contract amendments"
    },
    {
      "block_id": "11392a2871dd::b0005",
      "section_id": "11392a2871dd::s003",
      "type": "paragraph",
      "heading_path": [
        "Buyer's Guide Modify a contract - Administrative guidance for implementing contract modifications",
        "Buyer's Guide",
        "Administrative guidance for implementing contract amendments"
      ],
      "markdown": "The guidance detailed below will help you fulfill the administrative requirements for modifying a contract.",
      "plain_text": "The guidance detailed below will help you fulfill the administrative requirements for modifying a contract."
    },
    {
      "block_id": "11392a2871dd::b0006",
      "section_id": "11392a2871dd::s003",
      "type": "list",
      "heading_path": [
        "Buyer's Guide Modify a contract - Administrative guidance for implementing contract modifications",
        "Buyer's Guide",
        "Administrative guidance for implementing contract amendments"
