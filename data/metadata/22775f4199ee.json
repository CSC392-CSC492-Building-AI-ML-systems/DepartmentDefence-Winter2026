      "table_count": 0,
      "list_count": 0,
      "paragraph_count": 1,
      "first_block_index": 7,
      "last_block_index": 8,
      "preview": "Revision issuance You can issue revisions to extend the period of the standing offer (SO) or to update any pertinent details within the standing offer.",
