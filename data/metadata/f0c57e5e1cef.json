    {
      "block_id": "f0c57e5e1cef::b0005",
      "section_id": "f0c57e5e1cef::s003",
      "type": "paragraph",
      "heading_path": [
        "Buyer's Guide Manage payments - Overtime",
        "Buyer's Guide",
        "Overtime"
      ],
      "markdown": "When overtime is performed under a contract, Canada may incur added costs due to overtime premiums. Recognition of the additional costs by Canada depends upon the attendant circumstances and the cause for the overtime. Work performed under a contract should not result in higher overtime charges than would apply to similar commercial work.",
      "plain_text": "When overtime is performed under a contract, Canada may incur added costs due to overtime premiums. Recognition of the additional costs by Canada depends upon the attendant circumstances and the cause for the overtime. Work performed under a contract should not result in higher overtime charges than would apply to similar commercial work."
    },
