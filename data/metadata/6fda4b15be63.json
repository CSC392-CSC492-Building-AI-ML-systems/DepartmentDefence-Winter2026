      "markdown": "## Interest payments",
      "plain_text": "Interest payments"
    },
    {
      "block_id": "6fda4b15be63::b0005",
      "section_id": "6fda4b15be63::s003",
      "type": "paragraph",
      "heading_path": [
        "Buyer's Guide Manage payments - Interest payments",
        "Buyer's Guide",
        "Interest payments"
      ],
      "markdown": "Canada pays for work performed or goods received under a contract in accordance with Canada's standard payment period of 30 days as provided in the general conditions. The general conditions also reflect Canada's policy to automatically pay interest to contractors when an account is overdue, and Canada is responsible for the delay.",
      "plain_text": "Canada pays for work performed or goods received under a contract in accordance with Canada's standard payment period of 30 days as provided in the general conditions. The general conditions also reflect Canada's policy to automatically pay interest to contractors when an account is overdue, and Canada is responsible for the delay."
    },
    {
      "block_id": "6fda4b15be63::b0006",
      "section_id": "6fda4b15be63::s003",
      "type": "paragraph",
      "heading_path": [
        "Buyer's Guide Manage payments - Interest payments",
        "Buyer's Guide",
        "Interest payments"
